# CourseForge Environment Variables Configuration

# -----------------------------------------------------------------------------
# Supabase Configuration (Optional - Offline IndexedDB/LocalStorage is default)
# -----------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# YouTube Data API (Optional - Fallback noembed API used automatically)
# -----------------------------------------------------------------------------
PUBLIC_YOUTUBE_API_KEY=[GCP_API_KEY]

# -----------------------------------------------------------------------------
# App Configuration & Deployment
# -----------------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:4321
PUBLIC_APP_NAME=CourseForge
NODE_ENV=development
